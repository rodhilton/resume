<%-
load 'lib/common.rb'
require 'cgi'

def plain_text(value)
  CGI.unescapeHTML(value.to_s.gsub(/<[^>]*>/, '')).strip
end

# Match the compact PDF's content and ordering, with plain labels and one column.
# Keep each accomplishment on its own physical line; do not hard-wrap sentences.
full = flags[:complete_history]
lines = [plain_text(name), plain_text(title)]
lines << "Phone: #{flags[:phone]}" if flags[:phone]
lines << "Email: #{flags[:email]}" if flags[:email]
lines << 'Website: https://rodhilton.com'
lines << 'LinkedIn: https://www.linkedin.com/in/rodhilton'
lines << plain_text(traits.join(' | '))
lines.concat(['', 'Skills'])
weights = calculate_skill_weights(experience.jobs + education.degrees + projects + publications, 0.1, 0.08, 15)
group_by_category(weights, skills_index, 15).each do |category, skills|
  lines << "#{plain_text(category)}: #{skills.join(', ')}"
end

lines.concat(['', 'Experience'])
jobs = full ? experience.jobs : trim_jobs(experience.jobs, 17)
jobs.each_with_index do |job, index|
  employer = plain_text(job.company)
  employer += " (#{plain_text(job.note)})" if job.note
  location = ['Remote', 'Hybrid'].include?(job.environment) ? 'Remote' : job.location
  lines.concat(['', employer, plain_text(job.title)])
  lines << "Team: #{plain_text(job.team)}" if job.team
  # Month/year dates help distinguish adjacent jobs; missing end dates mean Present.
  lines << "Dates: #{job.start_time} - #{job.end_time || 'Present'}"
  lines << "Location: #{plain_text(location)}" if location
  lines << "- Utilized #{plain_text(trim_skills(job.technologies, 16))}." if full && job.technologies
  accomplishments = full ? job.accomplishments : trim_accomplishments(job.accomplishments, index, 6, 2)
  accomplishments.each { |item| lines << "- #{plain_text(item)}" }
end

lines.concat(['', 'Education'])
education.degrees.each do |degree|
  lines.concat(['', plain_text(degree.school), plain_text(degree.title)])
  lines << "Location: #{plain_text(degree.location)}" if degree.location
  lines << "- Utilized #{plain_text(trim_skills(degree.technologies, 16))}." if full && degree.technologies
  lines << "- #{plain_text(degree.note)}" if degree.note
  coursework = format_coursework(degree.coursework, selected: !full)
  lines << "Coursework: #{plain_text(coursework)}" unless coursework.empty?
end

if flags[:certifications]
  lines.concat(['', 'Certifications'])
  certifications.each do |certification|
    parts = [certification.title, certification.subject, certification.year].compact
    lines << parts.map { |part| plain_text(part) }.reject(&:empty?).join(' - ')
  end
end

lines.concat(['', 'Publications'])
pubs = full ? publications : trim_by_clout(publications, 7).sort_by { |pub| pub.year }.reverse
pubs.each do |pub|
  publication_title = plain_text(pub.title)
  publication_title += " by #{plain_text(pub.author)}" if pub.author
  lines.concat(['', publication_title, "#{plain_text(pub.role)} - #{plain_text(pub.type)}",
                "#{plain_text(pub.publisher)} | #{pub.year}"])
  lines << "URL: #{pub.url}" if pub.url
  lines << plain_text(pub.summary) if full && pub.summary
end

lines.concat(['', 'Projects'])
project_list = full ? projects : trim_by_clout(projects, 8).sort_by { |project| project.year }.reverse
project_list.each do |project|
  lines.concat(['', plain_text(project.title), plain_text(project.role)])
  lines << "Dates: #{plain_text(project.time)}" if project.time && !project.time.to_s.empty?
  lines << "#{plain_text(project.location)}: #{project.url}" if project.url
  lines << plain_text(project.description)
end
-%>
<%= lines.join("\n") %>
